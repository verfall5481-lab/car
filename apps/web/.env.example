# demo is the default. live requires a Supabase URL and public client key.
VITE_APP_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_KAKAO_JS_KEY=
VITE_ENABLE_KAKAO_LOGIN=false
VITE_TURNSTILE_SITE_KEY=
VITE_DEMO=false
# true turns /v/ in live mode into the web vehicle simulator: a real server session
# with simulated vehicle values (always sent as demo values) and simulated navigation.
VITE_LIVE_VEHICLE_SIM=false
